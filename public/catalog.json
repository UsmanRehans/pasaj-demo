100% natural ingredients and is free of parabens and phthalates.</h5>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</article>", "published_at": "2019-09-08T14:40:03-05:00", "created_at": "2019-06-26T14:16:18-05:00", "updated_at": "2026-09-21T10:43:47-05:00", "vendor": "Pasaj Perfume", "product_type": "Perfume Oil", "tags": ["Gifts", "Orris", "Patchouli", "Pink Peppercorn", "Rose", "Women"], "variants": [{"id": 29240601837612, "title": "5 ml", "option1": "5 ml", "option2": null, "option3": null, "sku": "", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "45.00", "grams": 85, "compare_at_price": null, "position": 1, "product_id": 3882148429868, "created_at": "2019-06-26T14:16:18-05:00", "updated_at": "2026-09-21T10:43:47-05:00"}, {"id": 42631874183256, "title": "10 ml", "option1": "10 ml", "option2": null, "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "78.00", "grams": 85, "compare_at_price": null, "position": 2, "product_id": 3882148429868, "created_at": "2025-01-30T11:05:35-06:00", "updated_at": "2026-09-21T10:43:47-05:00"}], "images": [{"id": 45314914943064, "created_at": "2026-08-08T15:46:04-05:00", "position": 1, "updated_at": "2026-08-08T15:46:06-05:00", "product_id": 3882148429868, "variant_ids": [], "src": "/assets/ff8dcaed2ed9-Rose_Ottoman.jpg", "width": 2000, "height": 2000}, {"id": 45507459448920, "created_at": "2026-08-25T16:50:32-05:00", "position": 2, "updated_at": "2026-08-25T16:50:33-05:00", "product_id": 3882148429868, "variant_ids": [], "src": "/assets/a1a5c2bccc83-Perfume_oil_-_Rose_Ottoman.png", "width": 800, "height": 800}, {"id": 45280653541464, "created_at": "2026-08-04T19:14:55-05:00", "position": 3, "updated_at": "2026-08-04T19:15:40-05:00", "product_id": 3882148429868, "variant_ids": [], "src": "/assets/89a10a218487-DTS_In_Focus_Daniel_Faro_Photos_ID5015.jpg", "width": 1068, "height": 1067}, {"id"