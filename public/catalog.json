 ml"]}]}, {"id": 8346142015576, "title": "Nerol\u00e9", "handle": "nerole", "body_html": "<h5>Nerol\u00e9 captures the quiet glow of morning light\u2014bright with citrusy petitgrain and soft neroli, gently grounded by creamy sandalwood. Its uplifting floral warmth brings clarity and calm to any space.</h5>\n<h5>Our Nerol\u00e9 perfumed candle is made with natural soy wax and is free of parabens and phthalates.</h5>", "published_at": "2025-04-15T23:10:10-05:00", "created_at": "2025-04-15T00:20:16-05:00", "updated_at": "2026-09-21T10:43:47-05:00", "vendor": "Pasaj Perfume", "product_type": "Candle", "tags": ["Gifts", "Men", "Women"], "variants": [{"id": 42815897075800, "title": "255 g", "option1": "255 g", "option2": null, "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": null, "available": false, "price": "64.00", "grams": 0, "compare_at_price": null, "position": 2, "product_id": 8346142015576, "created_at": "2025-04-15T00:20:16-05:00", "updated_at": "2026-09-21T10:43:47-05:00"}], "images": [{"id": 45308296822872, "created_at": "2026-08-07T17:13:45-05:00", "position": 1, "updated_at": "2026-08-07T17:13:46-05:00", "product_id": 8346142015576, "variant_ids": [], "src": "/assets/e8d9d9b8af40-Nerole.jpg", "width": 2000, "height": 2000}, {"id": 45507989733464, "created_at": "2026-08-25T18:56:43-05:00", "position": 2, "updated_at": "2026-08-25T18:56:45-05:00", "product_id": 8346142015576, "variant_ids": [], "src": "/assets/48c4ce0bd626-Candles_-_Nerole.png", "width": 800, "height": 800}, {"id": 34836240957528, "created_at": "2025-04-15T23:05:46-05:00", "position": 3, "updated_at": "2026-04-12T16:20:55-05:00", "product_id": 8346142015576, "variant_ids": [], "src": "/assets/578485255c09-nerole_candle_packaging_square.jpg", "width": 3600, "height": 3600}], "options": [{"name": "Size", "position": 1, "values": ["255 g"]}]}, {"id": 8339357630552, "title": "Regenerating Night Face Serum", "handle": "regenerating-night-face-serum", "body